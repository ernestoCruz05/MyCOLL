@page "/register"
@using MyCOLL.UIComponents.Services
@inject CollectionApiService ApiService
@inject NavigationManager NavManager

<div class="rustic-theme auth-wrapper">
    <div class="auth-container">
        <div class="rustic-auth-card wide dashed-border">
            <div class="auth-header">
                <h3 class="auth-title">Registo de Membro</h3>
                <div class="decorative-line"></div>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="rustic-alert alert-error">
                    <i class="fas fa-exclamation-triangle"></i> @errorMessage
                </div>
            }
            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="rustic-alert alert-success">
                    <i class="fas fa-check-circle"></i> @successMessage
                </div>
            }

            <EditForm Model="@registerModel" OnValidSubmit="HandleRegister">
                <DataAnnotationsValidator />

                <div class="form-group">
                    <label class="rustic-label">Email</label>
                    <div class="input-with-icon">
                        <i class="fas fa-envelope"></i>
                        <InputText @bind-Value="registerModel.Email" class="rustic-input" />
                    </div>
                    <ValidationMessage For="@(() => registerModel.Email)" class="validation-msg" />
                </div>

                <div class="form-group">
                    <label class="rustic-label">Palavra-Passe</label>
                    <div class="input-with-icon">
                        <i class="fas fa-lock"></i>
                        <InputText @bind-Value="registerModel.Password" type="password" class="rustic-input" />
                    </div>
                    <ValidationMessage For="@(() => registerModel.Password)" class="validation-msg" />
                </div>

                <div class="form-group">
                    <label class="rustic-label">Confirmar Palavra-Passe</label>
                    <div class="input-with-icon">
                        <i class="fas fa-lock-open"></i>
                        <InputText @bind-Value="registerModel.ConfirmPassword" type="password" class="rustic-input" />
                    </div>
                    <ValidationMessage For="@(() => registerModel.ConfirmPassword)" class="validation-msg" />
                </div>

                <div class="form-group">
                    <label class="checkbox-container">
                        <InputCheckbox @bind-Value="isFornecedor" />
                        <span class="checkmark"></span>
                        <span style="position:relative; z-index:2;">Pretendo vender produtos (Conta Fornecedor)</span>
                    </label>
                </div>

                <button type="submit" class="rustic-btn-primary @(isFornecedor ? "btn-vendor" : "")">
                    @if (isFornecedor)
                    {
                        <i class="fas fa-store"></i>
                    }
                    else
                    {

                        <i class="fas fa-user-plus"></i>
                    }
                    @(isFornecedor ? "Registar como Fornecedor" : "Criar Registo")
                </button>
            </EditForm>

            <div class="auth-footer">
                <span class="text-muted" style="opacity: 0.8; color: var(--rustic-medium);">Já possui credenciais?</span>
                <a href="/login" class="rustic-link">Entrar no Arquivo</a>
            </div>
        </div>
    </div>
</div>

@code {
    private class RegisterModel
    {
        [Required, EmailAddress] public string Email { get; set; } = "";
        [Required, MinLength(6)] public string Password { get; set; } = "";
        [Compare(nameof(Password))] public string ConfirmPassword { get; set; } = "";
    }

    private RegisterModel registerModel = new();
    private bool isFornecedor = false;
    private string errorMessage = "";
    private string successMessage = "";

    private async Task HandleRegister()
    {
        errorMessage = "";
        successMessage = "";
        AuthResult result;

        if (isFornecedor)
        {
            result = await ApiService.RegisterFornecedorAsync(registerModel.Email, registerModel.Password, registerModel.ConfirmPassword);
        }
        else
        {
            result = await ApiService.RegisterAsync(registerModel.Email, registerModel.Password, registerModel.ConfirmPassword);
        }

        if (result.Success)
        {
            if (isFornecedor)
            {
                successMessage = "Conta criada! Aguarde a aprovação do administrador para fazer login.";
                registerModel = new();
            }
            else
            {
                NavManager.NavigateTo("/login");
            }
        }
        else
        {
            errorMessage = result.Message;
        }
    }
}