@page "/register"
@using MyCOLL.UIComponents.Services
@using System.ComponentModel.DataAnnotations 
@inject CollectionApiService ApiService
@inject NavigationManager NavManager

<div class="rustic-theme auth-wrapper">
    <div class="auth-container">
        <div class="rustic-auth-card wide dashed-border">
            <div class="auth-header">
                <h3 class="auth-title">Registo de Membro</h3>
                <div class="decorative-line"></div>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="rustic-alert alert-error">
                    <i class="fas fa-exclamation-triangle"></i> @errorMessage
                </div>
            }
            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="rustic-alert alert-success">
                    <i class="fas fa-check-circle"></i> @successMessage
                </div>
            }

            <EditForm Model="@registerModel" OnValidSubmit="HandleRegister">
                <DataAnnotationsValidator />

                <div class="form-group">
                    <label class="rustic-label">Email</label>
                    <div class="input-with-icon">
                        <i class="fas fa-envelope"></i>
                        <InputText @bind-Value="registerModel.Email" class="rustic-input" placeholder="seu@email.com" />
                    </div>
                    <ValidationMessage For="@(() => registerModel.Email)" class="validation-msg" />
                </div>

                <div class="form-group">
                    <label class="rustic-label">Palavra-Passe</label>
                    <div class="input-with-icon">
                        <i class="fas fa-lock"></i>
                        <InputText @bind-Value="registerModel.Password" type="password" class="rustic-input" />
                    </div>
                    <ValidationMessage For="@(() => registerModel.Password)" class="validation-msg" />
                </div>

                <div class="form-group">
                    <label class="rustic-label">Confirmar Palavra-Passe</label>
                    <div class="input-with-icon">
                        <i class="fas fa-lock-open"></i>
                        <InputText @bind-Value="registerModel.ConfirmPassword" type="password" class="rustic-input" />
                    </div>
                    <ValidationMessage For="@(() => registerModel.ConfirmPassword)" class="validation-msg" />
                </div>

                <div class="form-group mt-3">
                    <label class="checkbox-container">
                        <InputCheckbox @bind-Value="registerModel.Fornecedor" />
                        <span class="checkmark"></span>
                        <span style="position:relative; z-index:2; font-weight:bold;">Pretendo vender produtos (Conta Fornecedor)</span>
                    </label>
                </div>

                @if (registerModel.Fornecedor)
                {
                    <div class="supplier-fields fade-in-up" style="background: rgba(0,0,0,0.03); padding: 15px; border-radius: 8px; margin-bottom: 15px;">
                        <h5 style="color: var(--rustic-dark); font-size: 0.9rem; margin-bottom: 10px; border-bottom: 1px solid #ccc; padding-bottom: 5px;">
                            <i class="fas fa-building"></i> Dados da Empresa
                        </h5>

                        <div class="form-group">
                            <label class="rustic-label">Nome da Empresa / Loja</label>
                            <InputText @bind-Value="registerModel.NomeEmpresa" class="rustic-input" />
                        </div>

                        <div class="row">
                            <div class="col-6">
                                <div class="form-group">
                                    <label class="rustic-label">NIF</label>
                                    <InputText @bind-Value="registerModel.NIF" class="rustic-input" />
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="form-group">
                                    <label class="rustic-label">Telefone</label>
                                    <InputText @bind-Value="registerModel.TelefoneEmpresa" class="rustic-input" />
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="rustic-label">Morada Completa</label>
                            <InputTextArea @bind-Value="registerModel.MoradaEmpresa" class="rustic-input" rows="2" />
                        </div>
                    </div>
                }

                <button type="submit" class="rustic-btn-primary @(registerModel.Fornecedor ? "btn-vendor" : "")">
                    @if (registerModel.Fornecedor)
                    {
                        <i class="fas fa-store"></i> <span>Registar Fornecedor</span>
                    }
                    else
                    {
                        <i class="fas fa-user-plus"></i> <span>Criar Conta Cliente</span>
                    }
                </button>
            </EditForm>

            <div class="auth-footer">
                <div style="margin-bottom: 12px;">
                    <span class="text-muted" style="opacity: 0.8; color: var(--rustic-medium);">Já possui conta?</span>
                    <a href="/login" class="rustic-link">Entrar no Arquivo</a>
                </div>
                <div style="border-top: 1px dashed rgba(93, 64, 55, 0.2); padding-top: 10px;">
                    <a href="/" class="rustic-link" style="margin-left: 0; font-size: 0.9em;">
                        <i class="fas fa-arrow-left"></i> Voltar à Página Principal
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>

@code {
    private RegisterUserDto registerModel = new();
    
    private string errorMessage = "";
    private string successMessage = "";

    private async Task HandleRegister()
    {
        errorMessage = "";
        successMessage = "";

        if (registerModel.Fornecedor && string.IsNullOrWhiteSpace(registerModel.NomeEmpresa))
        {
            errorMessage = "O Nome da Empresa é obrigatório para fornecedores.";
            return;
        }

        var result = await ApiService.RegisterUserAsync(registerModel);

        if (result.Success)
        {
            successMessage = result.Message;
            if (!registerModel.Fornecedor)
            {
                await Task.Delay(2000);
                NavManager.NavigateTo("/login");
            }
            else
            {
                registerModel = new();
            }
        }
        else
        {
            errorMessage = result.Message;
        }
    }
}