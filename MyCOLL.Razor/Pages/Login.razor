@page "/login"
@using MyCOLL.UIComponents.Services
@inject CollectionApiService ApiService
@inject UserService UserService
@inject NavigationManager NavManager

<div class="rustic-theme auth-wrapper">
    <div class="auth-container">
        <div class="rustic-auth-card">
            <div class="auth-header">
                <h3 class="auth-title">Acesso ao Arquivo</h3>
                <div class="decorative-line"></div>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="rustic-alert alert-error">
                    <i class="fas fa-exclamation-circle"></i> @errorMessage
                </div>
            }

            <EditForm Model="@loginModel" OnValidSubmit="HandleLogin">
                <DataAnnotationsValidator />

                <div class="form-group">
                    <label class="rustic-label">Identificador (Email)</label>
                    <div class="input-with-icon">
                        <i class="fas fa-envelope"></i>
                        <InputText @bind-Value="loginModel.Email" class="rustic-input" placeholder="email@exemplo.com" />
                    </div>
                </div>

                <div class="form-group">
                    <label class="rustic-label">Chave de Acesso (Password)</label>
                    <div class="input-with-icon">
                        <i class="fas fa-lock"></i>
                        <InputText @bind-Value="loginModel.Password" type="password" class="rustic-input" placeholder="******" />
                    </div>
                </div>

                <button type="submit" class="rustic-btn-primary">
                    <i class="fas fa-sign-in-alt"></i> Abrir Sessão
                </button>
            </EditForm>

            <div class="auth-footer">
                <span class="text-muted" style="opacity: 0.8; color: var(--rustic-medium);">Novo colecionador?</span>
                <a href="/register" class="rustic-link">Assinar Registo</a>
            </div>
        </div>
    </div>
</div>

@code {
    private class LoginModel
    {
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
    }

    private LoginModel loginModel = new();
    private string errorMessage = "";

    private async Task HandleLogin()
    {
        errorMessage = "";
        var result = await ApiService.LoginAsync(loginModel.Email, loginModel.Password);

        if (result.Success)
        {
            UserService.SetUser("userId_placeholder", loginModel.Email, loginModel.Email, result.Token);
            NavManager.NavigateTo("/");
        }
        else
        {
            errorMessage = result.Message;
        }
    }
}