@page "/login"
@using MyCOLL.UIComponents.Services
@using System.IdentityModel.Tokens.Jwt
@using System.Security.Claims
@inject CollectionApiService ApiService
@inject UserService UserService
@inject NavigationManager NavManager

<div class="rustic-theme auth-wrapper">
    <div class="auth-container">
        <div class="rustic-auth-card">
            <div class="auth-header">
                <h3 class="auth-title">Acesso ao Arquivo</h3>
                <div class="decorative-line"></div>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="rustic-alert alert-error">
                    <i class="fas fa-exclamation-circle"></i> @errorMessage
                </div>
            }

            <EditForm Model="@loginModel" OnValidSubmit="HandleLogin">
                <DataAnnotationsValidator />

                <div class="form-group">
                    <label class="rustic-label">Identificador (Email)</label>
                    <div class="input-with-icon">
                        <i class="fas fa-envelope"></i>
                        <InputText @bind-Value="loginModel.Email" class="rustic-input" placeholder="email@exemplo.com" />
                    </div>
                </div>

                <div class="form-group">
                    <label class="rustic-label">Chave de Acesso (Password)</label>
                    <div class="input-with-icon">
                        <i class="fas fa-lock"></i>
                        <InputText @bind-Value="loginModel.Password" type="password" class="rustic-input" placeholder="******" />
                    </div>
                </div>

                <button type="submit" class="rustic-btn-primary">
                    <i class="fas fa-sign-in-alt"></i> Abrir Sessão
                </button>
            </EditForm>

            <div class="auth-footer">
                <div style="margin-bottom: 12px;">
                    <span class="text-muted" style="opacity: 0.8; color: var(--rustic-medium);">Novo colecionador?</span>
                    <a href="/register" class="rustic-link">Assinar Registo</a>
                </div>

                <div style="border-top: 1px dashed rgba(93, 64, 55, 0.2); padding-top: 10px;">
                    <a href="/" class="rustic-link" style="margin-left: 0; font-size: 0.9em;">
                        <i class="fas fa-arrow-left"></i> Voltar à Página Principal
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>

@code {
    private class LoginModel
    {
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
    }

    private LoginModel loginModel = new();
    private string errorMessage = "";

    private async Task HandleLogin()
    {
        errorMessage = "";
        var result = await ApiService.LoginAsync(loginModel.Email, loginModel.Password);

        if (result.Success && !string.IsNullOrEmpty(result.Token))
        {
            // Extrair o Role do Token
            var role = GetRoleFromToken(result.Token);
            var name = GetNameFromToken(result.Token) ?? loginModel.Email;

            // Agora passamos o Role correto!
            UserService.SetUser("userId_placeholder", name, loginModel.Email, role, result.Token);

            NavManager.NavigateTo("/");
        }
        else
        {
            errorMessage = result.Message;
        }
    }

    private string GetRoleFromToken(string token)
    {
        try
        {
            var handler = new JwtSecurityTokenHandler();
            var jwtToken = handler.ReadJwtToken(token);
            var roleClaim = jwtToken.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role || c.Type == "role");
            return roleClaim?.Value ?? "Cliente";
        }
        catch
        {
            return "Cliente";
        }
    }

    private string? GetNameFromToken(string token)
    {
        try
        {
            var handler = new JwtSecurityTokenHandler();
            var jwtToken = handler.ReadJwtToken(token);
            // Tenta obter o nome único ou o claim "name"
            var nameClaim = jwtToken.Claims.FirstOrDefault(c => c.Type == "unique_name" || c.Type == ClaimTypes.Name);
            return nameClaim?.Value;
        }
        catch
        {
            return null;
        }
    }
}