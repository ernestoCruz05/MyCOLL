@using MyCOLL.UIComponents.Models

<div class="category-slider-wrapper">
    <!-- Main Categories Slider -->
    <div class="category-slider-container compact">
        <button class="slider-arrow" @onclick="ScrollLeft" disabled="@(!canScrollLeft)">
            <i class="fas fa-chevron-left"></i>
        </button>

        <div class="category-slider" @ref="sliderRef">
            <button class="category-chip @(SelectedCategoryId == null ? "active" : "")"
                    @onclick="() => SelectCategory(null)">
                <i class="fas fa-th-large"></i>
                <span>Todas</span>
            </button>

            @foreach (var category in Categories)
            {
                <button class="category-chip @(SelectedCategoryId == category.Id ? "active" : "")"
                        @onclick="() => SelectCategory(category.Id)">
                    @if (!string.IsNullOrEmpty(category.ImagemUrl))
                    {
                        <img src="@category.ImagemUrl" alt="@category.Nome" class="category-image" style="width:32px; height:32px; object-fit:cover; border-radius:8px;" />
                    }
                    else
                    {
                        <i class="@GetCategoryIcon(category.Nome)"></i>
                    }
                    <span>@category.Nome</span>
                </button>
            }
        </div>

        <button class="slider-arrow" @onclick="ScrollRight" disabled="@(!canScrollRight)">
            <i class="fas fa-chevron-right"></i>
        </button>
    </div>

    <!-- Subcategories Slider (shown when a category is selected) -->
    @if (SelectedCategoryId != null && Subcategories.Any())
    {
        <div class="subcategory-slider-container">
            <button class="slider-arrow small" @onclick="ScrollSubLeft" disabled="@(!canScrollSubLeft)">
                <i class="fas fa-chevron-left"></i>
            </button>

            <div class="subcategory-slider" @ref="subSliderRef">
                <button class="subcategory-chip @(selectedSubcategoryId == null ? "active" : "")"
                        @onclick="() => SelectSubcategory(null)">
                    <span>Todas</span>
                </button>

                @foreach (var subcategory in Subcategories)
                {
                    <button class="subcategory-chip @(selectedSubcategoryId == subcategory.Id ? "active" : "")"
                            @onclick="() => SelectSubcategory(subcategory.Id)">
                        <span>@subcategory.Nome</span>
                    </button>
                }
            </div>

            <button class="slider-arrow small" @onclick="ScrollSubRight" disabled="@(!canScrollSubRight)">
                <i class="fas fa-chevron-right"></i>
            </button>
        </div>
    }
</div>

@code {
    [Parameter] public List<Categoria> Categories { get; set; } = new();
    [Parameter] public List<Subcategoria> Subcategories { get; set; } = new();
    [Parameter] public int? SelectedCategoryId { get; set; }
    [Parameter] public EventCallback<int?> OnCategorySelected { get; set; }
    [Parameter] public EventCallback<int?> OnSubcategorySelected { get; set; }

    private ElementReference sliderRef;
    private ElementReference subSliderRef;
    private int? selectedSubcategoryId;

    private bool canScrollLeft = false;
    private bool canScrollRight = true;
    private bool canScrollSubLeft = false;
    private bool canScrollSubRight = true;

    private async Task SelectCategory(int? categoryId)
    {
        selectedSubcategoryId = null;
        await OnCategorySelected.InvokeAsync(categoryId);
    }

    private async Task SelectSubcategory(int? subcategoryId)
    {
        selectedSubcategoryId = subcategoryId;
        await OnSubcategorySelected.InvokeAsync(subcategoryId);
    }

    private void ScrollLeft()
    {
        canScrollLeft = false;
        canScrollRight = true;
    }

    private void ScrollRight()
    {
        canScrollLeft = true;
        canScrollRight = false;
    }

    private void ScrollSubLeft()
    {
        canScrollSubLeft = false;
        canScrollSubRight = true;
    }

    private void ScrollSubRight()
    {
        canScrollSubLeft = true;
        canScrollSubRight = false;
    }

    private string GetCategoryIcon(string? categoryName)
    {
        return (categoryName?.ToLower() ?? "") switch
        {
            "antiguidades" => "fas fa-hourglass-half",
            "moedas" => "fas fa-coins",
            "selos" => "fas fa-stamp",
            "arte" => "fas fa-palette",
            "livros" => "fas fa-book",
            "joias" => "fas fa-gem",
            "relógios" => "fas fa-clock",
            "móveis" => "fas fa-couch",
            "porcelanas" => "fas fa-wine-glass",
            "brinquedos" => "fas fa-puzzle-piece",
            _ => "fas fa-tag"
        };
    }
}