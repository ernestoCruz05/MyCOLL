@using MyCOLL.UIComponents.Services
@using Microsoft.AspNetCore.Components.Routing
@inject NavigationManager NavManager
@inject CartService CartService
@inject UserService UserService
@implements IDisposable

<div class="rustic-navbar">
    <div class="navbar-brand" @onclick="GoHome" style="cursor: pointer;">
        <i class="fas fa-scroll"></i>
        <span class="brand-text ms-2">MyCOLL</span>
    </div>

    <div class="navbar-search">
        <div class="search-container">
            <i class="fas fa-search search-icon"></i>
            <input type="text"
                   class="search-input"
                   placeholder="Search artifacts..."
                   @bind="searchTerm"
                   @bind:event="oninput"
                   @onkeyup="HandleKeyUp" />
            @if (!string.IsNullOrEmpty(searchTerm))
            {
                <button class="search-clear" @onclick="ClearSearch">
                    <i class="fas fa-times"></i>
                </button>
            }
        </div>
    </div>

    <div class="navbar-actions">
        <button class="nav-btn cart-btn" @onclick="ToggleCart" title="Shopping Cart">
            <i class="fas fa-shopping-basket"></i>
            @if (CartService.ItemCount > 0)
            {
                <span class="cart-badge">@CartService.ItemCount</span>
            }
        </button>

        @if (UserService.IsLoggedIn)
        {
            <div class="user-menu">
                <button class="nav-btn user-btn" @onclick="ToggleUserMenu" title="@UserService.CurrentUser?.Name">
                    <span class="user-avatar">@UserService.CurrentUser?.Initials</span>
                </button>

                @if (showUserMenu)
                {
                    <div class="user-dropdown">
                        <div class="dropdown-header">
                            <strong>@UserService.CurrentUser?.Name</strong>
                            <div class="small text-muted">@UserService.CurrentUser?.Email</div>
                            @if (!string.IsNullOrEmpty(UserService.CurrentUser?.Role))
                            {
                                <div class="badge bg-secondary mt-1">@UserService.CurrentUser?.Role</div>
                            }
                        </div>
                        <div class="dropdown-divider"></div>

                        @* --- LÓGICA ESPECÍFICA DE PERFIL --- *@

                        @if (UserService.CurrentUser?.Role == "Fornecedor")
                        {
                            <button class="dropdown-item" @onclick="GoToMyProducts">
                                <i class="fas fa-box-open me-2"></i> My Products
                            </button>
                        }

                        @if (UserService.CurrentUser?.Role == "Cliente" || string.IsNullOrEmpty(UserService.CurrentUser?.Role))
                        {
                            <button class="dropdown-item" @onclick="ViewOrders">
                                <i class="fas fa-receipt me-2"></i> My Orders
                            </button>
                        }

                        <button class="dropdown-item" @onclick="ViewProfile">
                            <i class="fas fa-user-cog me-2"></i> Profile
                        </button>

                        <div class="dropdown-divider"></div>

                        <button class="dropdown-item logout-item text-danger" @onclick="HandleLogout">
                            <i class="fas fa-sign-out-alt me-2"></i> Logout
                        </button>
                    </div>
                }
            </div>
        }
        else
        {
            <button class="nav-btn login-btn" @onclick="ShowLogin" title="Login">
                <i class="fas fa-user me-2"></i>
                <span class="login-text">Login</span>
            </button>
        }
    </div>
</div>

@if (showUserMenu)
{
    <div class="overlay-backdrop" @onclick="CloseUserMenu"></div>
}

@code {
    [Parameter] public EventCallback OnCartToggle { get; set; }
    [Parameter] public EventCallback OnLoginRequest { get; set; }
    [Parameter] public EventCallback<string> OnSearch { get; set; }
    [Parameter] public EventCallback OnHomeClick { get; set; }

    [Parameter] public int CartCount { get; set; } // Mantido para compatibilidade
    [Parameter] public EventCallback OnCartClick { get; set; } // Mantido para compatibilidade

    private string searchTerm = string.Empty;
    private bool showUserMenu = false;

    protected override void OnInitialized()
    {
        // Subscrever eventos para atualizar a UI quando o estado muda
        CartService.OnCartChanged += StateHasChanged;
        UserService.OnUserChanged += StateHasChanged;
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await OnSearch.InvokeAsync(searchTerm);
        }
    }

    private async Task ClearSearch()
    {
        searchTerm = string.Empty;
        await OnSearch.InvokeAsync(string.Empty);
    }

    private async Task ToggleCart()
    {
        // Tenta usar o evento novo, se não tiver delegate, usa o antigo
        if (OnCartToggle.HasDelegate)
            await OnCartToggle.InvokeAsync();
        else if (OnCartClick.HasDelegate)
            await OnCartClick.InvokeAsync();
    }

    private void ToggleUserMenu()
    {
        showUserMenu = !showUserMenu;
    }

    private void CloseUserMenu()
    {
        showUserMenu = false;
    }

    private void ShowLogin()
    {
        NavManager.NavigateTo("login");
    }

    private async Task GoHome()
    {
        if (OnHomeClick.HasDelegate)
            await OnHomeClick.InvokeAsync();
        else
            NavManager.NavigateTo("/");
    }

    private void HandleLogout()
    {
        UserService.Logout();
        // CartService.ClearCart(); // Opcional: limpar carrinho ao sair
        showUserMenu = false;
        NavManager.NavigateTo("/", forceLoad: true);
    }

    private void GoToMyProducts()
    {
        showUserMenu = false;
        NavManager.NavigateTo("my-products");
    }

    private void ViewOrders()
    {
        showUserMenu = false;
        NavManager.NavigateTo("my-orders");
    }

    private void ViewProfile()
    {
        showUserMenu = false;
        NavManager.NavigateTo("profile");
    }

    public void Dispose()
    {
        CartService.OnCartChanged -= StateHasChanged;
        UserService.OnUserChanged -= StateHasChanged;
    }
}