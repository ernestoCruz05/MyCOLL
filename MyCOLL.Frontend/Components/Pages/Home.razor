@page "/"
@using MyCOLL.UIComponents.Services
@using MyCOLL.UIComponents.Models
@using MyCOLL.UIComponents.Components
@inject CollectionApiService ApiService
@inject CartService CartService
@inject UserService UserService

<div class="rustic-theme">
    <RusticNavbar 
        OnCartToggle="ToggleCart" 
        OnLoginRequest="ShowLoginModal" 
        OnSearch="HandleSearch"
        OnHomeClick="ResetView" />

    @if (categories != null && categories.Any())
    {
        <div class="big-category-slider">
            <div class="category-poster @(selectedCategoryId == null ? "active" : "")"
                 @onclick="() => FilterByCategory(null)">
                <div class="poster-placeholder">
                    <i class="fas fa-globe-europe"></i>
                </div>
                <div class="poster-overlay">
                    <span class="poster-title">ALL</span>
                </div>
            </div>

            @foreach (var cat in MainCategories)
            {
                <div class="category-poster @(selectedCategoryId == cat.Id ? "active" : "")"
                     @onclick="() => FilterByCategory(cat.Id)">

                    @if (!string.IsNullOrEmpty(cat.ImagemUrl))
                    {
                        <img src="@GetFullImageUrl(cat.ImagemUrl)" class="poster-img" alt="@cat.Nome" />
                    }
                    else
                    {
                        <div class="poster-placeholder">
                            <i class="fas fa-image"></i>
                        </div>
                    }

                    <div class="poster-overlay">
                        <span class="poster-title">@cat.Nome</span>
                    </div>
                </div>
            }
        </div>

        @if (SelectedMainCategory?.SubCategorias != null && SelectedMainCategory.SubCategorias.Any())
        {
            <div class="subcategory-strip fade-in">
                <span class="strip-label">
                    <i class="fas fa-level-down-alt"></i> @SelectedMainCategory.Nome:
                </span>
                <div class="chip-scroller">
                    <button class="rustic-chip @(selectedSubId == null ? "active" : "")"
                            @onclick="() => SelectSubCategory(null)">
                        Ver Tudo
                    </button>
                    @foreach (var sub in SelectedMainCategory.SubCategorias)
                    {
                        <button class="rustic-chip @(selectedSubId == sub.Id ? "active" : "")"
                                @onclick="() => SelectSubCategory(sub.Id)">
                            @sub.Nome
                        </button>
                    }
                </div>
            </div>
        }
    }

    <div class="main-content">
        <div class="section-header">
            <h2 class="section-title">
                @if (!string.IsNullOrEmpty(searchTerm))
                {
                    <i class="fas fa-search"></i> <span>Resultados: "@searchTerm"</span>
                }
                else if (selectedCategoryId != null)
                {
                    <i class="fas fa-tag"></i> <span>@GetSelectedCategoryName()</span>
                }
                else
                {
                    <i class="fas fa-gem"></i> <span>Featured Collection</span>
                }
            </h2>
        </div>

        @if (isLoading)
        {
            <div class="loading-container">
                <div class="loading-spinner"></div>
                <p class="loading-text">Discovering artifacts...</p>
            </div>
        }
        else if (products == null || !products.Any())
        {
            <div class="empty-state">
                <i class="fas fa-box-open"></i>
                <h4>No artifacts found</h4>
            </div>
        }
        else
        {
            <div class="product-grid">
                @foreach (var item in products)
                {
                    <ProductCard Product="item" OnInspect="InspectProduct" OnAddToCart="HandleAddToCart" />
                }
            </div>
        }
    </div>

    @if (randomProduct != null && showRecommendation)
    {
        <div class="recommendation-banner fade-in-up">
            <button class="close-rec-btn" @onclick="() => showRecommendation = false">
                <i class="fas fa-times"></i>
            </button>
            
            <div class="rec-header">
                 Recomendado: </div>
            
            <div class="rec-content" @onclick="() => InspectProduct(randomProduct)">
                <div class="rec-img-wrapper">
                    <img src="@randomProduct.ImagemUrl" alt="@randomProduct.Nome" 
                         onerror="this.style.display='none';this.nextElementSibling.style.display='block';" />
                    <i class="fas fa-cube" style="display:none; font-size: 1.5rem; color: #888;"></i>
                </div>
                
                <div class="rec-info">
                    <span class="rec-name">@((randomProduct.Nome.Length > 20) ? randomProduct.Nome.Substring(0, 20) + "..." : randomProduct.Nome)</span>
                    <span class="rec-price">@randomProduct.Preco.ToString("C")</span>
                </div>
                
                <div class="rec-arrow">
                    <i class="fas fa-chevron-right"></i>
                </div>
            </div>
        </div>
    }

    <div class="decorative-border"></div>
</div>

<CartDrawer IsOpen="isCartOpen" OnClose="CloseCart" OnCheckout="HandleCheckout" />
<ProductDetailModal Product="selectedProduct" CategoryName="@GetCategoryName(selectedProduct?.CategoriaId)"
                    IsVisible="isModalOpen" OnClose="CloseModal" OnAddToCart="HandleModalAddToCart" />
@if (showToast) { <div class="toast-notification"><i class="fas fa-check-circle"></i><span>@toastMessage</span></div> }

@code {
    // Data
    private List<Produto>? products;
    private List<Categoria>? categories;
    
    // Recommendation Logic
    private Produto? randomProduct;
    // Inicializa como true sempre que a página carrega
    private bool showRecommendation = true;

    // State
    private bool isLoading = true;
    private bool isCartOpen = false;
    private bool isModalOpen = false;
    private Produto? selectedProduct;
    private int? selectedCategoryId = null;
    private int? selectedSubId = null;
    private string searchTerm = string.Empty;
    private bool showToast = false;
    private string toastMessage = string.Empty;

    IEnumerable<Categoria> MainCategories 
    {
        get
        {
            if (categories == null) return Enumerable.Empty<Categoria>();
            var subIds = categories.Where(c => c.SubCategorias != null)
                .SelectMany(c => c.SubCategorias).Select(sc => sc.Id).ToHashSet();
            return categories.Where(c => c.CategoriaPaiId == null && !subIds.Contains(c.Id));
        }
    }

    Categoria? SelectedMainCategory => categories?.FirstOrDefault(c => c.Id == selectedCategoryId);

    protected override async Task OnInitializedAsync()
    {
        await LoadInitialData();
    }

    private async Task LoadInitialData()
    {
        isLoading = true;
        try
        {
            var categoriesTask = ApiService.GetCategoriesAsync();
            var productsTask = ApiService.GetProductsAsync();
            await Task.WhenAll(categoriesTask, productsTask);
            categories = await categoriesTask;
            products = await productsTask;

            // Pick a random product for recommendation
            if (products != null && products.Count > 0)
            {
                var rnd = new Random();
                randomProduct = products[rnd.Next(products.Count)];
                // Garante que aparece no reload
                showRecommendation = true; 
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
            products = new List<Produto>();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task FilterByCategory(int? categoryId)
    {
        selectedCategoryId = categoryId;
        selectedSubId = null;
        searchTerm = string.Empty;
        await LoadProducts(selectedCategoryId);
    }

    private async Task SelectSubCategory(int? subId)
    {
        selectedSubId = subId;
        await LoadProducts(subId ?? selectedCategoryId);
    }

    private async Task LoadProducts(int? id)
    {
        isLoading = true;
        StateHasChanged();
        try { products = await ApiService.GetProductsAsync(id); }
        finally { isLoading = false; StateHasChanged(); }
    }

    private async Task HandleSearch(string term)
    {
        searchTerm = term;
        selectedCategoryId = null;
        if (string.IsNullOrWhiteSpace(term)) { await LoadInitialData(); return; }
        isLoading = true;
        products = await ApiService.SearchProductsAsync(term);
        isLoading = false;
    }

    private async Task ResetView() => await LoadInitialData();

    private string GetFullImageUrl(string? imageUrl)
    {
        if (string.IsNullOrEmpty(imageUrl)) return "";
        if (imageUrl.StartsWith("http")) return imageUrl;
        return $"{ApiService.GetBaseUrl().TrimEnd('/')}/{imageUrl.TrimStart('/')}";
    }

    private string GetSelectedCategoryName()
    {
        if (selectedSubId != null) return GetCategoryName(selectedSubId) ?? "Subcategory";
        if (selectedCategoryId != null) return GetCategoryName(selectedCategoryId) ?? "Category";
        return "All Collections";
    }

    private string? GetCategoryName(int? categoryId)
    {
        if (categoryId == null || categories == null) return null;
        var all = categories.Concat(categories.SelectMany(c => c.SubCategorias)).ToList();
        return all.FirstOrDefault(c => c.Id == categoryId)?.Nome;
    }

    // UI Actions
    private void InspectProduct(Produto product) { selectedProduct = product; isModalOpen = true; }
    private void CloseModal() { isModalOpen = false; selectedProduct = null; }
    private void HandleAddToCart(Produto product) { ShowToast($"Added '{product.Nome}' to cart"); }
    private void HandleModalAddToCart((Produto product, int quantity) args) { ShowToast($"Added {args.quantity}x '{args.product.Nome}' to cart"); }
    private void ToggleCart() => isCartOpen = !isCartOpen;
    private void CloseCart() => isCartOpen = false;
    private void HandleCheckout() { if(!UserService.IsLoggedIn){ShowLoginModal(); return;} ShowToast("Checkout..."); CloseCart(); }
    private void ShowLoginModal() { ShowToast("Please login first"); }
    private async void ShowToast(string message) { toastMessage = message; showToast = true; StateHasChanged(); await Task.Delay(3000); showToast = false; StateHasChanged(); }
}