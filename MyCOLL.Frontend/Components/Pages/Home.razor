@page "/"
@using MyCOLL.UIComponents.Services
@using MyCOLL.UIComponents.Models
@using MyCOLL.UIComponents.Components
@inject CollectionApiService ApiService
@inject CartService CartService
@inject UserService UserService

<div class="app-container">
    <!-- Navbar -->
    <RusticNavbar OnCartToggle="ToggleCart"
                  OnLoginRequest="ShowLoginModal"
                  OnSearch="HandleSearch"
                  OnHomeClick="ResetView" />

    <!-- Category Slider with Image Support -->
    <div class="category-slider-wrapper">
        <div class="category-slider-container">
            <button class="slider-arrow" disabled="@(!canScrollLeft)">
                <i class="fas fa-chevron-left"></i>
            </button>
            <!-- Update the category chip section (around lines 30-55) to use ImagemDataUrl -->

            <div class="category-slider">
                <!-- "Todas" Category -->
                <div class="category-chip @(selectedCategoryId == null ? "active" : "")"
                     @onclick="() => FilterByCategory(null)">
                    <div class="category-image">
                        <span class="placeholder-text">ALL</span>
                    </div>
                    <span class="category-name">Todas</span>
                </div>

                @if (categories != null)
                {
                    @foreach (var category in categories)
                    {
                        <div class="category-chip @(selectedCategoryId == category.Id ? "active" : "")"
                             @onclick="() => FilterByCategory(category.Id)">
                            <div class="category-image">
                                @if (!string.IsNullOrEmpty(category.ImagemUrl))
                                {
                                    <img src="@category.ImagemUrl" alt="@category.Nome" />
                                }
                                else
                                {
                                    <span class="placeholder-text">@GetCategoryInitials(category.Nome)</span>
                                }
                            </div>
                            <span class="category-name">@category.Nome</span>
                        </div>
                    }
                }
            </div>

            <button class="slider-arrow" disabled="@(!canScrollRight)">
                <i class="fas fa-chevron-right"></i>
            </button>
        </div>

        <!-- Subcategories -->
        @if (selectedCategoryId != null && subcategories.Any())
        {
            <div class="subcategory-slider-container">
                <button class="slider-arrow small" disabled="@(!canScrollSubLeft)">
                    <i class="fas fa-chevron-left"></i>
                </button>

                <div class="subcategory-slider">
                    <button class="subcategory-chip @(selectedSubcategoryId == null ? "active" : "")"
                            @onclick="() => FilterBySubcategory(null)">
                        Todas
                    </button>

                    @foreach (var sub in subcategories)
                    {
                        <button class="subcategory-chip @(selectedSubcategoryId == sub.Id ? "active" : "")"
                                @onclick="() => FilterBySubcategory(sub.Id)">
                            @sub.Nome
                        </button>
                    }
                </div>

                <button class="slider-arrow small" disabled="@(!canScrollSubRight)">
                    <i class="fas fa-chevron-right"></i>
                </button>
            </div>
        }
    </div>

    <!-- Main Content -->
    <div class="main-content">
        <div class="section-header">
            <h2 class="section-title">
                @if (!string.IsNullOrEmpty(searchTerm))
                {
                    <span>Resultados para "@searchTerm"</span>
                }
                else if (selectedCategoryId != null)
                {
                    @* Only show category name, no description *@
                    <span>@GetSelectedCategoryName()</span>
                }
                else
                {
                    <span>Todos os Produtos</span>
                }
            </h2>
            @if (products != null)
            {
                <span class="product-count">@products.Count produto(s)</span>
            }
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="empty-state" style="color: var(--danger);">
                <h4>Erro ao carregar</h4>
                <p>@errorMessage</p>
            </div>
        }
        else if (isLoading)
        {
            <div class="loading-container">
                <div class="loading-spinner"></div>
                <p class="loading-text">A carregar produtos...</p>
            </div>
        }
        else if (products == null || !products.Any())
        {
            <div class="empty-state">
                <h4>Nenhum produto encontrado</h4>
                <p>Tente selecionar outra categoria ou ajuste a sua pesquisa</p>
            </div>
        }
        else
        {
            <div class="product-grid">
                @foreach (var item in products)
                {
                    <ProductCard Product="item"
                                 OnInspect="InspectProduct"
                                 OnAddToCart="HandleAddToCart" />
                }
            </div>
        }
    </div>

    <div class="decorative-border"></div>
</div>

<CartDrawer IsOpen="isCartOpen"
            OnClose="CloseCart"
            OnCheckout="HandleCheckout" />

<ProductDetailModal Product="selectedProduct"
                    CategoryName="@GetCategoryName(selectedProduct?.CategoriaId)"
                    IsVisible="isModalOpen"
                    OnClose="CloseModal"
                    OnAddToCart="HandleModalAddToCart" />

@if (showToast)
{
    <div class="toast-notification">
        <span>@toastMessage</span>
    </div>
}

@code {
    private List<Produto>? products;
    private List<Produto>? allProducts;
    private List<Categoria>? categories;
    private List<Subcategoria> subcategories = new();

    private bool isLoading = true;
    private bool isCartOpen = false;
    private bool isModalOpen = false;
    private Produto? selectedProduct;
    private int? selectedCategoryId = null;
    private int? selectedSubcategoryId = null;
    private string searchTerm = string.Empty;
    private string? errorMessage;

    private bool canScrollLeft = false;
    private bool canScrollRight = true;
    private bool canScrollSubLeft = false;
    private bool canScrollSubRight = true;

    private bool showToast = false;
    private string toastMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadInitialData();
    }

    private async Task LoadInitialData()
    {
        isLoading = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            var categoriesTask = ApiService.GetCategoriesAsync();
            var productsTask = ApiService.GetProductsAsync();

            await Task.WhenAll(categoriesTask, productsTask);

            categories = await categoriesTask;
            allProducts = await productsTask;
            products = allProducts;

            Console.WriteLine($"Loaded {categories?.Count ?? 0} categories, {products?.Count ?? 0} products");
        }
        catch (Exception ex)
        {
            errorMessage = "Não foi possível conectar ao servidor.";
            Console.WriteLine($"Error: {ex.Message}");
            products = new List<Produto>();
            allProducts = new List<Produto>();
            categories = new List<Categoria>();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task FilterByCategory(int? categoryId)
    {
        selectedCategoryId = categoryId;
        selectedSubcategoryId = null;
        searchTerm = string.Empty;

        if (categoryId.HasValue)
        {
            subcategories = GetMockSubcategories(categoryId.Value);
        }
        else
        {
            subcategories = new List<Subcategoria>();
        }

        await FilterProducts();
    }

    private async Task FilterBySubcategory(int? subcategoryId)
    {
        selectedSubcategoryId = subcategoryId;
        await FilterProducts();
    }

    private List<Subcategoria> GetMockSubcategories(int categoryId)
    {
        var categoryName = categories?.FirstOrDefault(c => c.Id == categoryId)?.Nome?.ToLower() ?? "";

        return categoryName switch
        {
            "moedas" => new List<Subcategoria>
            {
                new() { Id = 1, CategoriaId = categoryId, Nome = "Ouro" },
                new() { Id = 2, CategoriaId = categoryId, Nome = "Prata" },
                new() { Id = 3, CategoriaId = categoryId, Nome = "Bronze" },
                new() { Id = 4, CategoriaId = categoryId, Nome = "Comemorativas" }
            },
            "selos" => new List<Subcategoria>
            {
                new() { Id = 5, CategoriaId = categoryId, Nome = "Portugueses" },
                new() { Id = 6, CategoriaId = categoryId, Nome = "Europeus" },
                new() { Id = 7, CategoriaId = categoryId, Nome = "Mundiais" }
            },
            "antiguidades" => new List<Subcategoria>
            {
                new() { Id = 8, CategoriaId = categoryId, Nome = "Século XVIII" },
                new() { Id = 9, CategoriaId = categoryId, Nome = "Século XIX" },
                new() { Id = 10, CategoriaId = categoryId, Nome = "Século XX" }
            },
            "arte" => new List<Subcategoria>
            {
                new() { Id = 11, CategoriaId = categoryId, Nome = "Pinturas" },
                new() { Id = 12, CategoriaId = categoryId, Nome = "Esculturas" },
                new() { Id = 13, CategoriaId = categoryId, Nome = "Gravuras" }
            },
            _ => new List<Subcategoria>()
        };
    }

    private async Task FilterProducts()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            if (selectedCategoryId == null)
            {
                products = allProducts;
            }
            else
            {
                products = await ApiService.GetProductsAsync(selectedCategoryId);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
            products = new List<Produto>();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleSearch(string term)
    {
        searchTerm = term;
        selectedCategoryId = null;
        selectedSubcategoryId = null;
        subcategories = new List<Subcategoria>();

        if (string.IsNullOrWhiteSpace(term))
        {
            await LoadInitialData();
            return;
        }

        isLoading = true;
        StateHasChanged();

        try
        {
            products = await ApiService.SearchProductsAsync(term);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
            products = new List<Produto>();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ResetView()
    {
        searchTerm = string.Empty;
        selectedCategoryId = null;
        selectedSubcategoryId = null;
        subcategories = new List<Subcategoria>();
        await LoadInitialData();
    }

    /// <summary>
    /// Gets the first 2 letters of the category name as initials
    /// </summary>
    private string GetCategoryInitials(string? name)
    {
        if (string.IsNullOrEmpty(name)) return "?";
        return name.Length >= 2 ? name[..2].ToUpper() : name.ToUpper();
    }

    /// <summary>
    /// Handles image load errors by hiding the broken image
    /// </summary>
    private void HandleImageError(Microsoft.AspNetCore.Components.Web.ErrorEventArgs e)
    {
        // The image failed to load - the placeholder will show instead via CSS
        Console.WriteLine("Category image failed to load");
    }

    private void InspectProduct(Produto product)
    {
        selectedProduct = product;
        isModalOpen = true;
        StateHasChanged();
    }

    private void CloseModal()
    {
        isModalOpen = false;
        selectedProduct = null;
        StateHasChanged();
    }

    private void HandleAddToCart(Produto product)
    {
        CartService.AddItem(product);
        ShowToast($"'{product.Nome}' adicionado ao carrinho");
    }

    private void HandleModalAddToCart((Produto product, int quantity) args)
    {
        CartService.AddItem(args.product, args.quantity);
        ShowToast($"{args.quantity}x '{args.product.Nome}' adicionado");
        CloseModal();
    }

    private void ToggleCart()
    {
        isCartOpen = !isCartOpen;
        StateHasChanged();
    }

    private void CloseCart()
    {
        isCartOpen = false;
        StateHasChanged();
    }

    private void HandleCheckout()
    {
        if (!UserService.IsLoggedIn)
        {
            ShowLoginModal();
            ShowToast("Por favor, faça login para continuar");
            return;
        }
        ShowToast("A processar checkout...");
        CloseCart();
    }

    private void ShowLoginModal()
    {
        ShowToast("Funcionalidade de login em breve");
    }

    private string GetSelectedCategoryName()
    {
        if (selectedCategoryId == null || categories == null)
            return "Todas";
        return categories.FirstOrDefault(c => c.Id == selectedCategoryId)?.Nome ?? "Categoria";
    }

    private string GetSelectedSubcategoryName()
    {
        if (selectedSubcategoryId == null) return "";
        return subcategories.FirstOrDefault(s => s.Id == selectedSubcategoryId)?.Nome ?? "";
    }

    private string? GetCategoryName(int? categoryId)
    {
        if (categoryId == null || categories == null) return null;
        return categories.FirstOrDefault(c => c.Id == categoryId)?.Nome;
    }

    private async void ShowToast(string message)
    {
        toastMessage = message;
        showToast = true;
        StateHasChanged();
        await Task.Delay(3000);
        showToast = false;
        StateHasChanged();
    }
}