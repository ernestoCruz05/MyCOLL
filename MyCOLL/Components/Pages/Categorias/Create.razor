@page "/categorias/create"
@using MyCOLL.Entities
@using MyCOLL.Services
@inject CategoriaService CategoriaService
@inject NavigationManager Nav
@inject IWebHostEnvironment Env
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Gestor")]

<PageTitle>Nova Categoria</PageTitle>

<div class="container py-4" style="max-width: 800px;">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <h4 class="mb-0 fw-bold">Nova Categoria</h4>
        </div>
        <div class="card-body p-4">
            <EditForm Model="@categoria" OnValidSubmit="Guardar">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger mb-3" />

                <div class="mb-3">
                    <label class="form-label fw-semibold">Nome da Categoria</label>
                    <InputText @bind-Value="categoria.Nome" class="form-control" placeholder="Ex: Selos, Moedas" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Descrição</label>
                    <InputTextArea @bind-Value="categoria.Descricao" class="form-control" rows="3" />
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold">Imagem</label>
                    <InputFile OnChange="UploadImagem" class="form-control" accept=".jpg,.png,.webp" />

                    @if (!string.IsNullOrEmpty(categoria.ImagemUrl))
                    {
                        <div class="mt-3 p-2 border rounded bg-light text-center">
                            <img src="@categoria.ImagemUrl" alt="Pré-visualização" class="img-fluid rounded" style="max-height: 200px;" />
                            <div class="mt-1 small text-muted">Pré-visualização da imagem atual</div>
                        </div>
                    }
                </div>

                <div class="mb-4 form-check form-switch">
                    <InputCheckbox @bind-Value="categoria.Ativa" class="form-check-input" id="ativa" />
                    <label class="form-check-label" for="ativa">Categoria Ativa</label>
                </div>

                <div class="d-flex justify-content-end gap-2 border-top pt-3">
                    <a href="/categorias" class="btn btn-light border">Cancelar</a>
                    <button type="submit" class="btn btn-primary px-4">Criar Categoria</button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private Categoria categoria = new();

    protected override void OnInitialized()
    {
        categoria.Ativa = true;
    }

    private async Task UploadImagem(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            var nome = $"{Guid.NewGuid()}{Path.GetExtension(file.Name)}";
            var path = Path.Combine(Env.WebRootPath, "uploads", "categorias");
            Directory.CreateDirectory(path);

            await using var stream = file.OpenReadStream(5 * 1024 * 1024); 
            await using var fs = new FileStream(Path.Combine(path, nome), FileMode.Create);
            await stream.CopyToAsync(fs);

            categoria.ImagemUrl = $"/uploads/categorias/{nome}";
        }
    }

    private async Task Guardar()
    {
        await CategoriaService.AddAsync(categoria);
        Nav.NavigateTo("/categorias");
    }
}