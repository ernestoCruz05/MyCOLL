@page "/categorias"
@using MyCOLL.Entities
@inject MyCOLL.Services.CategoriaService CategoriaService
@inject NavigationManager NavigationManager
@inject IJSRuntime js
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Gestor,Fornecedor")]

<PageTitle>Categorias</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-normal mb-0">Gestão de Categorias</h2>
        <a href="/categorias/create" class="btn btn-dark">
            <i class="bi bi-plus-lg"></i> Nova Categoria
        </a>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 60px;">IMG</th>
                        <th style="width: 50px;">ID</th> 
                        <th>NOME</th>
                        <th>DESCRIÇÃO</th>
                        <th class="text-center">ESTADO</th>
                        <th class="text-center" style="width: 300px;">AÇÕES</th>
                    </tr>
                </thead>
                <tbody>
                    @if (categorias == null)
                    {
                        <tr><td colspan="6" class="text-center py-4">A carregar...</td></tr>
                    }
                    else if (!categorias.Any())
                    {
                        <tr><td colspan="6" class="text-center py-4 text-muted">Sem categorias registadas.</td></tr>
                    }
                    else
                    {
                        @foreach (var c in categorias)
                        {
                            bool temFilhas = c.SubCategorias != null && c.SubCategorias.Any();
                            bool aberto = IsExpanded(c.Id);


                            <tr class="bg-white">
                                <td>
                                    @if (!string.IsNullOrEmpty(c.ImagemUrl))
                                    {
                                        <img src="@c.ImagemUrl" class="rounded border" style="width: 40px; height: 40px; object-fit: cover;" />
                                    }
                                   
                                </td>
                                <td class="text-muted small">#@c.Id</td> 
                                <td class="fw-bold text-dark">@c.Nome</td>
                                <td class="text-muted small">@c.Descricao</td>
                                <td class="text-center">
                                    @if (c.Ativa)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Ativa</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Inativa</span>
                                    }
                                </td>

                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-1">
                                        @if (temFilhas)
                                        {
                                            <button class="btn btn-sm btn-outline-dark" @onclick="() => Toggle(c.Id)">
                                                @(aberto ? "Fechar" : "Subcategorias")
                                            </button>
                                        }
                                        else
                                        {
                                            <div style="width: 100px;"></div>
                                        }

                                        <a href="/categorias/edit/@c.Id" class="btn btn-sm btn-outline-secondary">
                                            Editar
                                        </a>

                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteCategoria(c.Id)">
                                            Eliminar
                                        </button>
                                    </div>
                                </td>
                            </tr>

                            @if (aberto && temFilhas)
                            {
                                @foreach (var sub in c.SubCategorias!)
                                {
                                    <tr style="background-color: #e9ecef;">

                                        <td>
                                    @if (!string.IsNullOrEmpty(c.ImagemUrl))
                                    {
                                        <img src="@c.ImagemUrl" class="rounded border" style="width: 40px; height: 40px; object-fit: cover;" />
                                    }
                                   
                                </td>
                                        <td class="text-muted small">#@sub.Id</td>

                                        <td class="text-secondary fw-semibold ps-4">
                                            @sub.Nome
                                        </td>

                                        <td class="text-muted small fst-italic">@sub.Descricao</td>

                                        <td class="text-center">
                                            @if (sub.Ativa)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle">Ativa</span>
                                            }
                                            else
                                            {

                                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Inativa</span>
                                            }
                                        </td>

                                        <td class="text-center">
                                            <div class="d-flex justify-content-center gap-1">
                                                <div style="width: 100px;"></div> 

                                                <a href="/categorias/edit/@sub.Id" class="btn btn-sm btn-outline-secondary bg-white">
                                                    Editar
                                                </a>
                                                <button class="btn btn-sm btn-outline-danger bg-white" @onclick="() => DeleteCategoria(sub.Id)">
                                                    Eliminar
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private List<Categoria>? categorias;
    private string? errorMessage;
    private HashSet<int> expandedIds = new();

    protected override async Task OnInitializedAsync()
    {
        await CarregarDados();
    }

    private async Task CarregarDados()
    {
        categorias = await CategoriaService.GetPrincipaisComSubAsync();
    }

    private void Toggle(int id)
    {
        if (expandedIds.Contains(id)) expandedIds.Remove(id);
        else expandedIds.Add(id);
    }

    private bool IsExpanded(int id) => expandedIds.Contains(id);

    private async Task DeleteCategoria(int id)
    {
        errorMessage = null;
        var confirmar = await js.InvokeAsync<bool>("confirm", "Tem a certeza que quer eliminar esta categoria?");

        if (confirmar)
        {
            try
            {
                await CategoriaService.DeleteAsync(id);
                await CarregarDados();
            }
            catch (Exception ex)
            {
                errorMessage = ex.Message;
            }
        }
    }
}