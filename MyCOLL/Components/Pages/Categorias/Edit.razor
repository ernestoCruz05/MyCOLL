@page "/categorias/edit/{id:int}"
@using MyCOLL.Entities
@using MyCOLL.Services
@inject CategoriaService CategoriaService
@inject NavigationManager Nav
@inject IWebHostEnvironment Env
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Gestor")]

<PageTitle>Editar Categoria</PageTitle>

<div class="container py-4" style="max-width: 800px;">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <h4 class="mb-0 fw-bold">Editar Categoria</h4>
        </div>
        <div class="card-body p-4">
            @if (categoria == null)
            {
                <div class="alert alert-warning">A carregar...</div>
            }
            else
            {
                <EditForm Model="@categoria" OnValidSubmit="Guardar">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger mb-3" />

            @if (categoria.SubCategorias != null && categoria.SubCategorias.Any())
                    {
                        <div class="alert alert-info small">
                            Esta categoria tem subcategorias. Não pode ser movida para dentro de outra.
                        </div>
                    }
                    else
                    {
                        <div class="mb-3 bg-light p-3 rounded border">
                            <label class="form-label fw-bold text-primary">Categoria Pai (Hierarquia)</label>
                            <InputSelect @bind-Value="categoria.CategoriaPaiId" class="form-select">
                                <option value="">-- É uma Categoria Principal --</option>
                                @foreach (var p in paisPossiveis)
                                {
                                    <option value="@p.Id">@p.Nome</option>
                                }
                            </InputSelect>
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nome</label>
                        <InputText @bind-Value="categoria.Nome" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Descrição</label>
                        <InputTextArea @bind-Value="categoria.Descricao" class="form-control" rows="3" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Imagem</label>
                        <InputFile OnChange="UploadImagem" class="form-control" accept=".jpg,.png,.webp" />
                        @if (!string.IsNullOrEmpty(categoria.ImagemUrl))
                        {
                            <div class="mt-2">
                                <img src="@categoria.ImagemUrl" height="100" class="rounded border" />
                            </div>
                        }
                    </div>

                    <div class="mb-4 form-check form-switch">
                        <InputCheckbox @bind-Value="categoria.Ativa" class="form-check-input" id="ativa" />
                        <label class="form-check-label" for="ativa">Ativa</label>
                    </div>

                    <div class="d-flex justify-content-end gap-2 border-top pt-3">
                        <a href="/categorias" class="btn btn-light border">Cancelar</a>
                        <button type="submit" class="btn btn-primary px-4">Guardar</button>
                    </div>
                </EditForm>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public int Id { get; set; }
    private Categoria? categoria;
    private List<Categoria> paisPossiveis = new();

    protected override async Task OnInitializedAsync()
    {
        categoria = await CategoriaService.GetByIdAsync(Id);
        if (categoria == null)
        {
            Nav.NavigateTo("/categorias");
            return;
        }

        var todos = await CategoriaService.GetPossiveisPaisAsync();
        paisPossiveis = todos.Where(c => c.Id != Id).ToList();
    }

    private async Task UploadImagem(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            var nome = $"{Guid.NewGuid()}{Path.GetExtension(file.Name)}";
            var path = Path.Combine(Env.WebRootPath, "uploads", "categorias");
            Directory.CreateDirectory(path);
            await using var stream = file.OpenReadStream(5 * 1024 * 1024);
            await using var fs = new FileStream(Path.Combine(path, nome), FileMode.Create);
            await stream.CopyToAsync(fs);
            categoria!.ImagemUrl = $"/uploads/categorias/{nome}";
        }
    }

    private async Task Guardar()
    {
        if (categoria != null)
        {
            await CategoriaService.UpdateAsync(categoria);
            Nav.NavigateTo("/categorias");
        }
    }
}