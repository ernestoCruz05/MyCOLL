@page "/produtos/criar"
@rendermode InteractiveServer
@using MyCOLL.Entities
@using MyCOLL.Services
@using Microsoft.AspNetCore.Components.Forms
@inject ProdutoService ProdutoService
@inject CategoriaService CategoriaService
@inject ModoEntregaService ModoEntregaService
@inject ImageUploadService ImageService
@inject NavigationManager Nav
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Gestor")]

<PageTitle>Novo Produto</PageTitle>

<div class="container py-4" style="max-width: 800px;">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <h4 class="mb-0 fw-bold">Novo Produto</h4>
        </div>
        <div class="card-body p-4">
            <EditForm Model="@produto" OnValidSubmit="Guardar">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger mb-3" />

                <div class="row mb-3">
                    <div class="col-md-8">
                        <label class="form-label fw-semibold">Nome do Produto</label>
                        <InputText @bind-Value="produto.Nome" class="form-control" placeholder="Ex: Selo Raro 1950" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Stock Inicial</label>
                        <InputNumber @bind-Value="produto.Stock" class="form-control" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Descrição</label>
                    <InputTextArea @bind-Value="produto.Descricao" class="form-control" rows="3" />
                </div>

                <div class="row mb-3 bg-light p-3 rounded mx-0 border">
                    <div class="col-md-4">
                        <label class="form-label fw-bold text-primary">Preço Base (€)</label>
                        <InputNumber @bind-Value="produto.PrecoBase" class="form-control" placeholder="Custo" />
                        <small class="text-muted">Custo do produto</small>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold text-success">Margem Loja (%)</label>
                        <InputNumber @bind-Value="produto.MargemLucro" class="form-control" />
                        <small class="text-muted">Lucro sobre o base</small>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Preço Final (€)</label>
                        <input type="text" class="form-control fw-bold" value="@((produto.PrecoBase * (1 + produto.MargemLucro/100)).ToString("C2"))" disabled />
                        <small class="text-muted">Valor de venda</small>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Categoria</label>
                        <InputSelect @bind-Value="produto.CategoriaId" class="form-select">
                            <option value="0">-- Selecionar --</option>
                            @foreach (var c in categorias) { <option value="@c.Id">@c.Nome</option> }
                        </InputSelect>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Modo de Entrega</label>
                        <InputSelect @bind-Value="produto.ModoEntregaId" class="form-select">
                            <option value="0">-- Selecionar --</option>
                            @foreach (var m in modos) { <option value="@m.Id">@m.Nome</option> }
                        </InputSelect>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold">Imagem</label>
                    <InputFile OnChange="HandleImageUpload" class="form-control" accept="image/*" />
                    <small class="text-muted">Formatos: JPG, PNG, WebP (máx. 2MB)</small>

                    @if (isUploading)
                    {
                        <div class="mt-2">
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            A processar imagem...
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(uploadedImageUrl))
                    {
                        <div class="mt-2">
                            <img src="@uploadedImageUrl" class="img-thumbnail" style="max-height: 150px;" />
                            <button type="button" class="btn btn-sm btn-outline-danger ms-2" @onclick="RemoveImage">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger mt-2 py-2">@errorMessage</div>
                    }
                </div>

                <div class="mb-4 form-check form-switch">
                    <InputCheckbox @bind-Value="produto.Ativo" class="form-check-input" id="ativo" />
                    <label class="form-check-label" for="ativo">Produto Ativo (Visível na loja)</label>
                </div>

                <div class="d-flex justify-content-end gap-2 border-top pt-3">
                    <button type="button" class="btn btn-light border" @onclick="Cancelar">Cancelar</button>
                    <button type="submit" class="btn btn-primary px-4" disabled="@isUploading">Criar Produto</button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private Produto produto = new();
    private List<Categoria> categorias = new();
    private List<ModoEntrega> modos = new();
    private string? uploadedImageUrl;
    private string? errorMessage;
    private bool isUploading;
    private const long MaxFileSize = 2 * 1024 * 1024;

    protected override async Task OnInitializedAsync()
    {
        categorias = await CategoriaService.GetAllAsync();
        modos = await ModoEntregaService.GetAllAsync();

        produto.MargemLucro = 20;
        produto.Ativo = true;
    }

    private async Task HandleImageUpload(InputFileChangeEventArgs e)
    {
        Console.WriteLine("HandleImageUpload: start");
        errorMessage = null;
        isUploading = true;

        // Remove previous uploaded image if any
        if (!string.IsNullOrEmpty(uploadedImageUrl))
        {
            ImageService.DeleteImage(uploadedImageUrl);
            uploadedImageUrl = null;
        }

        try
        {
            var file = e.File;
            Console.WriteLine($"File: {file?.Name}, Size: {file?.Size}");

            if (file == null)
            {
                errorMessage = "Nenhum ficheiro selecionado.";
                return;
            }

            if (!Services.ImageUploadService.IsValidImage(file.ContentType, file.Size, MaxFileSize))
            {
                errorMessage = file.Size > MaxFileSize
                    ? $"Ficheiro demasiado grande ({file.Size / 1024.0 / 1024.0:F2}MB). Máximo: 2MB"
                    : $"Formato não suportado ({file.ContentType}).";
                return;
            }

            await using var stream = file.OpenReadStream(MaxFileSize);
            Console.WriteLine("Stream opened");
            uploadedImageUrl = await ImageService.SaveImageAsync(stream, file.Name, "produtos");
            Console.WriteLine($"Image saved: {uploadedImageUrl}");
            produto.ImagemUrl = uploadedImageUrl;
            Console.WriteLine("produto.ImagemUrl set");
        }
        catch (Exception ex)
        {
            errorMessage = $"Erro: {ex.Message}";
            Console.WriteLine($"Exception: {ex}");
        }
        finally
        {
            isUploading = false;
            Console.WriteLine("HandleImageUpload: end");
        }
    }

    private void RemoveImage()
    {
        if (!string.IsNullOrEmpty(uploadedImageUrl))
        {
            ImageService.DeleteImage(uploadedImageUrl);
        }
        uploadedImageUrl = null;
        produto.ImagemUrl = null;
    }

    private async Task Guardar()
    {
        if (produto.CategoriaId == 0 || produto.ModoEntregaId == 0) return;
        await ProdutoService.AddAsync(produto);
        Nav.NavigateTo("/produtos");
    }

    private void Cancelar()
    {
        // Cleanup uploaded image if canceling
        if (!string.IsNullOrEmpty(uploadedImageUrl))
        {
            ImageService.DeleteImage(uploadedImageUrl);
        }
        Nav.NavigateTo("/produtos");
    }
}