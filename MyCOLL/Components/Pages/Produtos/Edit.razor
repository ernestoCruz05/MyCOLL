@page "/produtos/editar/{Id:int}"
@using MyCOLL.Entities
@using MyCOLL.Services
@inject ProdutoService ProdutoService
@inject CategoriaService CategoriaService
@inject ModoEntregaService ModoEntregaService
@inject NavigationManager Nav
@inject IWebHostEnvironment Env
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Gestor")]

<PageTitle>Editar Produto</PageTitle>

<div class="container py-4" style="max-width: 800px;">
    @if (produto != null)
    {
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h4 class="mb-0 fw-bold">Editar: @produto.Nome</h4>
                @if (!produto.Ativo)
                {
                    <span class="badge bg-warning text-dark">PENDENTE</span>
                }
                else
                {
                    <span class="badge bg-success">ATIVO</span>
                }
            </div>

            <div class="card-body p-4">
                @* AVISO PARA O ADMIN *@
                @if (!produto.Ativo)
                {
                    <div class="alert alert-warning border-start border-warning border-4 mb-4">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <strong>Produto Pendente:</strong> Para ativar este produto, deve definir uma <strong>Margem de Lucro</strong> válida (> 0%) e marcar a caixa "Ativo" abaixo.
                    </div>
                }

                <EditForm Model="@produto" OnValidSubmit="Guardar">
                    <DataAnnotationsValidator />

                    <div class="row mb-3">
                        <div class="col-md-8">
                            <label class="form-label fw-semibold">Nome</label>
                            <InputText @bind-Value="produto.Nome" class="form-control" />
                            <ValidationMessage For="@(() => produto.Nome)" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Stock</label>
                            <InputNumber @bind-Value="produto.Stock" class="form-control" />
                            <ValidationMessage For="@(() => produto.Stock)" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Descrição</label>
                        <InputTextArea @bind-Value="produto.Descricao" class="form-control" rows="3" />
                    </div>

                    @* SECÇÃO DE PREÇOS COM LÓGICA DE MARGEM *@
                    <div class="row mb-3 bg-light p-3 rounded mx-0 border">
                        <div class="col-md-4">
                            <label class="form-label fw-bold text-secondary">Preço Base (€)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white">€</span>
                                <InputNumber @bind-Value="produto.PrecoBase" class="form-control" />
                            </div>
                            <div class="form-text small">Definido pelo Fornecedor</div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold text-success">Margem (%)</label>
                            <div class="input-group">
                                <InputNumber @bind-Value="produto.MargemLucro" class="form-control border-success" />
                                <span class="input-group-text">%</span>
                            </div>
                            <ValidationMessage For="@(() => produto.MargemLucro)" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Preço Final (€)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white">€</span>
                                @* Cálculo em tempo real para visualização *@
                                <input type="text" class="form-control fw-bold bg-white"
                                       value="@((produto.PrecoBase * (1 + produto.MargemLucro / 100)).ToString("N2"))"
                                       disabled />
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Categoria Principal</label>
                            <select class="form-select mb-2" value="@SelectedMainCategoryId" @onchange="OnMainCategoryChange">
                                <option value="0">-- Selecione Principal --</option>
                                @foreach (var c in CategoriasPrincipais)
                                {
                                    <option value="@c.Id">@c.Nome</option>
                                }
                            </select>

                            @if (SubCategoriasDisponiveis.Any())
                            {
                                <div class="d-flex align-items-center mt-2">
                                    <label class="form-label fw-semibold small text-muted me-2 mb-0">Subcategoria:</label>
                                    <select class="form-select form-select-sm" value="@SelectedSubCategoryId" @onchange="OnSubCategoryChange">
                                        <option value="0">-- Nenhuma (Usar Principal) --</option>
                                        @foreach (var sub in SubCategoriasDisponiveis)
                                        {
                                            <option value="@sub.Id">@sub.Nome</option>
                                        }
                                    </select>
                                </div>
                            }
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Modo de Entrega</label>
                            <InputSelect @bind-Value="produto.ModoEntregaId" class="form-select">
                                @foreach (var m in modos)
                                {
                                    <option value="@m.Id">@m.Nome</option>
                                }
                            </InputSelect>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Imagem</label>
                        <InputFile OnChange="UploadImagem" class="form-control" accept=".jpg,.png" />
                        @if (!string.IsNullOrEmpty(produto.ImagemUrl))
                        {
                            <div class="mt-2">
                                <img src="@produto.ImagemUrl" class="img-thumbnail" style="height: 100px;" />
                            </div>
                        }
                    </div>

                    @* CHECKBOX DE ATIVAÇÃO CONDICIONAL *@
                    <div class="card mb-4 @(produto.MargemLucro > 0 ? "border-success" : "border-secondary")">
                        <div class="card-body d-flex align-items-center justify-content-between">
                            <div class="form-check form-switch">
                                <InputCheckbox @bind-Value="produto.Ativo" class="form-check-input" id="ativo" disabled="@(produto.MargemLucro <= 0)" />
                                <label class="form-check-label fw-bold" for="ativo">
                                    Produto Ativo (Visível na Loja)
                                </label>
                            </div>
                            @if (produto.MargemLucro <= 0)
                            {
                                <small class="text-danger">
                                    <i class="bi bi-lock-fill"></i> Defina a margem para desbloquear.
                                </small>
                            }
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3">
                        <a href="/produtos" class="btn btn-light border">Cancelar</a>
                        <button type="submit" class="btn btn-primary px-4">Guardar Alterações</button>
                    </div>
                </EditForm>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }
    private Produto? produto;

    private List<Categoria> todasCategorias = new();
    private List<Categoria> CategoriasPrincipais = new();
    private List<Categoria> SubCategoriasDisponiveis = new();
    private List<ModoEntrega> modos = new();

    private int SelectedMainCategoryId;
    private int SelectedSubCategoryId;

    protected override async Task OnInitializedAsync()
    {
        todasCategorias = await CategoriaService.GetAllAsync();
        modos = await ModoEntregaService.GetAllAsync();
        CategoriasPrincipais = todasCategorias.Where(c => c.CategoriaPaiId == null).ToList();

        produto = await ProdutoService.GetByIdAsync(Id);

        // Lógica para preencher dropdowns se o produto já tiver categoria
        if (produto != null && produto.CategoriaId > 0)
        {
            var catAtual = todasCategorias.FirstOrDefault(c => c.Id == produto.CategoriaId);

            if (catAtual != null)
            {
                if (catAtual.CategoriaPaiId != null)
                {
                    // É uma subcategoria
                    SelectedMainCategoryId = catAtual.CategoriaPaiId.Value;
                    SelectedSubCategoryId = catAtual.Id;
                }
                else
                {
                    // É uma categoria principal
                    SelectedMainCategoryId = catAtual.Id;
                    SelectedSubCategoryId = 0;
                }

                // Carregar as subs da principal selecionada
                SubCategoriasDisponiveis = todasCategorias
                    .Where(c => c.CategoriaPaiId == SelectedMainCategoryId)
                    .ToList();
            }
        }
    }

    private void OnMainCategoryChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int mainId))
        {
            SelectedMainCategoryId = mainId;
            SelectedSubCategoryId = 0;

            if (mainId > 0)
            {
                SubCategoriasDisponiveis = todasCategorias
                    .Where(c => c.CategoriaPaiId == mainId)
                    .ToList();

                produto.CategoriaId = mainId;
            }
            else
            {
                SubCategoriasDisponiveis.Clear();
                produto.CategoriaId = 0;
            }
        }
    }

    private void OnSubCategoryChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int subId))
        {
            SelectedSubCategoryId = subId;
            produto.CategoriaId = subId > 0 ? subId : SelectedMainCategoryId;
        }
    }

    private async Task UploadImagem(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null && produto != null)
        {
            var nome = $"{Guid.NewGuid()}{Path.GetExtension(file.Name)}";
            var path = Path.Combine(Env.WebRootPath, "uploads", "produtos");
            Directory.CreateDirectory(path);
            await using var stream = file.OpenReadStream(5 * 1024 * 1024);
            await using var fs = new FileStream(Path.Combine(path, nome), FileMode.Create);
            await stream.CopyToAsync(fs);
            produto.ImagemUrl = $"/uploads/produtos/{nome}";
        }
    }

    private async Task Guardar()
    {
        if (produto != null)
        {
            // Segurança: Se a margem for <= 0, força inativo (mesmo que tenham tentado aldrabar o HTML)
            if (produto.MargemLucro <= 0)
            {
                produto.Ativo = false;
            }

            // Recalcula o Preço Final antes de gravar
            produto.Preco = produto.PrecoBase + (produto.PrecoBase * (produto.MargemLucro / 100));

            await ProdutoService.UpdateAsync(produto);
            Nav.NavigateTo("/produtos");
        }
    }
}